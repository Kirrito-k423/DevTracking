    {
      "dot": "cyan",
      "title": "Runtime modes",
      "items": [
        "Standalone desktop Gantt requires no Docker",
        "Source mode serves exports/delivery on localhost",
        "Plane integration is optional and Docker-backed"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "PostgreSQL is read-only for analytics extraction",
        "Normal Plane writes require API key and confirmation",
        "Mutable Gantt state stays outside Plane internal schema"
      ]
    },
    {
      "dot": "emerald",
      "title": "Recovery and portability",
      "items": [
        "Restore selects the newest safe local or disk snapshot",
